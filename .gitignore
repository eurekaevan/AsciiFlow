# =========================================================================
# AsciiFlow Git Ignore Configuration
# =========================================================================

# -------------------------------------------------------------------------
# 1. 输出目录及运行产生的临时产物 (Output directory & run artifacts)
# -------------------------------------------------------------------------
output/
output*/
scratch/
*.log

# -------------------------------------------------------------------------
# 2. 多媒体文件 (Multimedia files)
# -------------------------------------------------------------------------
*.mp4
*.m4v
*.avi
*.mkv
*.mov
*.wmv
*.flv
*.webm
*.mp3
*.wav
*.aac
*.flac
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp

# Tiny self-generated regression media, with generator/version/checksums.
!tests/fixtures/media/*.mp4
!tests/fixtures/media/*.mkv
!tests/fixtures/codecs/*.mp4
!crates/asciiflow-media/tests/fixtures/*.mp4

# -------------------------------------------------------------------------
# 3. Build and native binary artifacts
# -------------------------------------------------------------------------
*.dll
*.exe
*.pdb
*.so
*.so.*
*.dylib
target/
third_party/ffmpeg/source/
third_party/ffmpeg/install/
third_party/ffmpeg/downloads/

# -------------------------------------------------------------------------
# 4. IDE 及编辑器配置文件 (IDE & Editor files)
# -------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
