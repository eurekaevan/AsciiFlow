#version 460
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_GOOGLE_include_directive : require
#include "pq_common.glsl"

layout(local_size_x = 32, local_size_y = 4) in;
layout(set = 0, binding = 1, std430) buffer Cells { HdrCell cells[]; };
layout(set = 0, binding = 3, std430) readonly buffer Atlas { uint8_t atlas[]; };
layout(set = 0, binding = 4, std430) writeonly buffer OutputP010 { uint16_t output_p010[]; };

layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint grid_width;
    uint grid_height;
    uint atlas_width;
    uint atlas_height;
    uint color;
    uint glyph_count;
    uint neutral_chroma;
} params;

uint cell_index_for(uint x, uint y) {
    return pq_cell_at(y, params.height, params.grid_height) * params.grid_width
        + pq_cell_at(x, params.width, params.grid_width);
}

uint alpha_for(uint glyph, uint x, uint y) {
    uint ax = pq_atlas_at(x, params.width, params.grid_width, params.atlas_width);
    uint ay = pq_atlas_at(y, params.height, params.grid_height, params.atlas_height);
    return uint(atlas[glyph * params.atlas_width * params.atlas_height
        + ay * params.atlas_width + ax]);
}

void main() {
    uint bx = gl_GlobalInvocationID.x * 2u;
    uint by = gl_GlobalInvocationID.y * 2u;
    if (bx >= params.width || by >= params.height) {
        return;
    }
    vec2 chroma_sum = vec2(0.0);
    for (uint dy = 0u; dy < 2u; dy++) {
        for (uint dx = 0u; dx < 2u; dx++) {
            uint x = bx + dx;
            uint y = by + dy;
            uint cell_index = cell_index_for(x, y);
            vec3 foreground = cells[cell_index].linear_and_perceptual.rgb;
            uint glyph = cells[cell_index].counts.x;
            bool valid = pq_finite(foreground)
                && !any(lessThan(foreground, vec3(0.0)))
                && !any(greaterThan(foreground, vec3(1.0)))
                && glyph < params.glyph_count;
            if (!valid) {
                atomicAdd(cells[cell_index].counts.z, 1u);
                foreground = vec3(0.0);
            }
            if (params.color == 0u) {
                foreground = vec3(pq_luminance(foreground));
            }
            float coverage = valid ? float(alpha_for(glyph, x, y)) / 255.0 : 0.0;
            vec3 encoded = pq_inverse_eotf(foreground * coverage);
            if (!pq_finite(encoded)) {
                atomicAdd(cells[cell_index].counts.z, 1u);
                encoded = pq_inverse_eotf(vec3(0.0));
            }
            vec3 ycbcr = pq_to_ycbcr(encoded);
            uint clamped;
            uvec3 codes = pq_encode_limited(ycbcr, clamped);
            // CPU diagnostics count all three components even when only Y is stored.
            atomicAdd(cells[cell_index].counts.w, clamped);
            output_p010[y * params.width + x] = uint16_t(codes.x << 6u);
            chroma_sum += ycbcr.yz;
        }
    }
    uint clamped;
    uvec3 codes = pq_encode_limited(vec3(0.0, chroma_sum / 4.0), clamped);
    atomicAdd(cells[cell_index_for(bx, by)].counts.w, clamped);
    uint uv = params.width * params.height + (by / 2u) * params.width + bx;
    output_p010[uv] = uint16_t(codes.y << 6u);
    output_p010[uv + 1u] = uint16_t(codes.z << 6u);
}
